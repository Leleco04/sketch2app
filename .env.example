# Preencha somente no .env. Copie os IDs atuais dos modelos no AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_FALLBACK=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PUBLIC_BASE_URL=

MAX_IMAGE_SIDE=1024
MAX_OUTPUT_TOKENS=16000
LLM_TIMEOUT_S=60
MIN_INTERVAL_S=7
HISTORY_TURNS=4
# Opcional: configure apenas se o modelo escolhido suportar.
THINKING_BUDGET=
# Modelos atuais: minimal/low/medium/high, conforme o modelo. Não combinar com budget.
THINKING_LEVEL=
RECORD=false
OFFLINE_MODE=false
# Desenvolvimento sem chave/cota; independente do replay offline.
MOCK_LLM=false
